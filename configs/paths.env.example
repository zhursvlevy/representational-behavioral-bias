# Copy to configs/paths.env and edit. Read by scripts/reproduce.sh.

# ImageNet (ILSVRC2012) validation images, one subfolder per WNID (n01440764/, ...).
IMAGENET_VAL_DIR=/path/to/imagenet/val

# Cue-conflict stimuli of Geirhos et al. (2019), "style-transfer-preprocessed-512",
# from https://github.com/rgeirhos/texture-vs-shape (stimuli/). Used only for the
# random-vs-grouped split comparison.
GEIRHOS_STIMULI_DIR=/path/to/texture-vs-shape/stimuli/style-transfer-preprocessed-512

# Where every generated artifact is written (stimuli, hidden states, results, figures).
OUTPUT_DIR=outputs

# Optional: directory with local model snapshots laid out as <org>/<name>
# (e.g. $MODELS_ROOT_PATH/llava-hf/llava-1.5-7b-hf). Leave empty to download from the Hub.
MODELS_ROOT_PATH=

# Optional: Hugging Face token; required for the gated google/paligemma2-10b-mix-224.
HF_TOKEN=
